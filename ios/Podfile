# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HealthsoftApp' do
  # Fix for FirebaseCoreInternal/GoogleUtilities modular headers when without use_frameworks!
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'V8SDK', :path => './V8SDK'
  pod 'V8Bridge', :path => './V8Bridge'
  pod 'EspBlufi', :podspec => './EspBlufi.podspec'
  pod 'EspBlufiBridge', :path => './EspBlufiBridge'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |build_configuration|
        # fmt 11 fails under the archive toolchain here unless it stays on C++17.
        build_configuration.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
      end
    end

    # Vendor V8 and Espressif OpenSSL static libraries currently ship with
    # iphoneos-only arm64 slices. Keep them for device builds, but strip them
    # from simulator link flags so Apple Silicon `run-ios` builds do not fail
    # with linker platform mismatch errors. EspBlufiBridge itself remains
    # linked on the simulator and reports that physical Bluetooth is required.
    pods_xcconfig_glob = File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-HealthsoftApp', 'Pods-HealthsoftApp*.xcconfig')
    Dir.glob(pods_xcconfig_glob).each do |xcconfig_path|
      next unless File.file?(xcconfig_path)

      lines = File.read(xcconfig_path).lines
      updated_lines = []
      changed = false
      injected = false

      lines.each do |line|
        if line.start_with?('OTHER_LDFLAGS[sdk=iphonesimulator*] = ') || line.start_with?('OTHER_LDFLAGS[sdk=iphoneos*] = ')
          changed = true
          next
        end

        unless line.start_with?('OTHER_LDFLAGS = ')
          updated_lines << line
          next
        end

        flags = line.sub('OTHER_LDFLAGS = ', '').strip
        device_only_libraries = %w[BleSDK EspBlufi crypto ssl]
        simulator_flags = device_only_libraries.reduce(flags) do |value, library|
          value.gsub(/\s-l\"#{library}\"/, '')
        end
        device_flags = device_only_libraries.map { |library| "-l\"#{library}\"" }.join(' ')
        updated_lines << "OTHER_LDFLAGS = #{simulator_flags}\n"
        updated_lines << "OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) #{device_flags}\n"
        injected = true
        changed = true
      end

      if changed && injected
        File.write(xcconfig_path, updated_lines.join)
      end
    end
  end
end
